# ===================================================================
# DPIP - Developer Project Intelligence Platform - .gitignore
# ===================================================================

# --- Maven Build Artifacts ---
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# --- Java & Class Files ---
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# --- Python Virtual Environments & Bytecode ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.coverage

# --- Local IDEs & Editors ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
*.sublime-project
*.sublime-workspace

# --- Environment & Sensitive Credentials ---
.env
.env.local
.env.*.local
*.secret
*.pem
*.key
set-supabase-env.ps1

# --- Operating System & Cache Files ---
.DS_Store
Thumbs.db
desktop.ini
*.log
logs/
.dsp/
.agents/
scratch/

# Keep gitignore and example configs
!.gitignore
!.env.example
!set-supabase-env.example.ps1
