# ===================================================================
# DPIP - Environment Variables Template
# Copy this file to .env and replace placeholders with your credentials
# ===================================================================

# --- Spring Profile Selection ---
# Options: 'local' (H2 in-memory DB) or 'prod' (Supabase/PostgreSQL)
SPRING_PROFILES_ACTIVE=local

# --- Supabase / PostgreSQL Database Configuration ---
# Required when running with SPRING_PROFILES_ACTIVE=prod
SUPABASE_DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your_secure_password_here

# --- AI & Agent Gateway Configuration ---
# CrewAI Python agent runner endpoint
CREWAI_API_URL=http://localhost:8081
AI_INTEGRATION_MODE=crewai

# Optional LLM API Keys (used by CrewAI or local inference)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_API_URL=http://localhost:11434

# --- GitHub Integration ---
# Optional GitHub Personal Access Token for repository analysis and webhooks
GITHUB_PAT=your_github_token_here

# --- Server Port ---
SERVER_PORT=8080
